import os
import time
import numpy as np
import xarray as xr

from scipy.stats import genextreme
from joblib import Parallel, delayed
from tqdm.auto import tqdm


# ============================================================
# 0. Settings
# ============================================================

data_file = 'IFS_t2m_hottest_month_bias_corrected.nc'

output_file = (
    'IFS_proxy_GEV_parameters_hottest_regional_'
    '1981_2024_land_bias_corrected.nc'
)

# Number of bootstrap/proxy samples
num_samples = 10000

# Number of parallel workers
n_jobs = 16

# Random seed for reproducibility
random_seed = 42


# ============================================================
# 1. Read data
# ============================================================

print("Reading data...")

ds = xr.open_dataset(data_file)

# Select period and enforce dimension order:
# region_id × number × year
da = (
    ds['t2m_hottest_month']
    .sel(year=slice('1981', '2024'))
    .transpose('region_id', 'number', 'year')
)

regions = da.region_id.values

# Load into memory
data = da.values

n_regions, n_members, n_years = data.shape

ds.close()

print("\n==============================")
print("Input information")
print("==============================")
print(f"Data shape        : {data.shape}")
print(f"Regions           : {n_regions}")
print(f"Ensemble members  : {n_members}")
print(f"Years             : {n_years}")
print(f"Bootstrap samples : {num_samples}")
print(f"Parallel workers  : {n_jobs}")


# ============================================================
# 2. Function for one region
# ============================================================

def fit_region_gev(region_index, region_data, num_samples, seed):
    """
    For one region:

    1. For each year, randomly select one ensemble member.
    2. Construct num_samples proxy time series.
    3. Fit a GEV distribution to each proxy series.
    4. Return location, scale, and conventional shape xi.

    scipy.stats.genextreme:
        c, loc, scale

    Conventional GEV shape:
        xi = -c
    """

    rng = np.random.default_rng(seed)

    n_members, n_years = region_data.shape

    # --------------------------------------------------------
    # Generate all bootstrap member indices at once
    # shape = (num_samples, n_years)
    # --------------------------------------------------------
    member_indices = rng.integers(
        low=0,
        high=n_members,
        size=(num_samples, n_years)
    )

    year_indices = np.arange(n_years)

    # --------------------------------------------------------
    # Construct proxy time series
    # sampled_data shape = (num_samples, n_years)
    # --------------------------------------------------------
    sampled_data = region_data[
        member_indices,
        year_indices[None, :]
    ]

    # Output arrays
    locations = np.full(
        num_samples,
        np.nan,
        dtype=np.float64
    )

    scales = np.full(
        num_samples,
        np.nan,
        dtype=np.float64
    )

    shapes = np.full(
        num_samples,
        np.nan,
        dtype=np.float64
    )

    # --------------------------------------------------------
    # GEV fitting
    # --------------------------------------------------------
    for j in range(num_samples):

        x = sampled_data[j]

        # Remove NaN/inf if present
        if not np.all(np.isfinite(x)):
            x = x[np.isfinite(x)]

        if x.size < 3:
            continue

        try:

            c, loc, scale = genextreme.fit(x)

            locations[j] = loc
            scales[j] = scale

            # Conventional GEV shape parameter xi
            shapes[j] = -c

        except Exception:

            # Keep NaN if fit fails
            continue

    return region_index, locations, scales, shapes


# ============================================================
# 3. Generate independent random seeds
# ============================================================

seed_sequence = np.random.SeedSequence(random_seed)

region_seed_sequences = seed_sequence.spawn(n_regions)

region_seeds = [
    int(s.generate_state(1)[0])
    for s in region_seed_sequences
]


# ============================================================
# 4. Initialize output arrays
# ============================================================

output_locations = np.full(
    (num_samples, n_regions),
    np.nan,
    dtype=np.float64
)

output_scales = np.full(
    (num_samples, n_regions),
    np.nan,
    dtype=np.float64
)

output_shapes = np.full(
    (num_samples, n_regions),
    np.nan,
    dtype=np.float64
)


# ============================================================
# 5. Parallel GEV fitting with real-time tqdm progress
# ============================================================

print("\nStarting parallel GEV fitting...\n")

start_time = time.time()

# ------------------------------------------------------------
# return_as="generator_unordered"
#
# Results are returned immediately whenever any worker
# finishes a region.
#
# Therefore tqdm updates continuously as regions finish.
# ------------------------------------------------------------
parallel_results = Parallel(
    n_jobs=n_jobs,
    backend='loky',
    return_as='generator_unordered'
)(
    delayed(fit_region_gev)(
        i,
        data[i],
        num_samples,
        region_seeds[i]
    )
    for i in range(n_regions)
)


# ------------------------------------------------------------
# Real-time progress bar
# ------------------------------------------------------------
for result in tqdm(
    parallel_results,
    total=n_regions,
    desc="Regions",
    unit="region"
):

    region_index, loc, scale, shape = result

    output_locations[:, region_index] = loc
    output_scales[:, region_index] = scale
    output_shapes[:, region_index] = shape


elapsed = time.time() - start_time


# ============================================================
# 6. Timing information
# ============================================================

print("\n==============================")
print("GEV fitting completed")
print("==============================")

print(
    f"Elapsed time: "
    f"{elapsed / 60:.2f} minutes"
)

print(
    f"Elapsed time: "
    f"{elapsed / 3600:.2f} hours"
)


# ============================================================
# 7. Fitting diagnostics
# ============================================================

total_fits = num_samples * n_regions

failed_location = np.isnan(output_locations).sum()
failed_scale = np.isnan(output_scales).sum()
failed_shape = np.isnan(output_shapes).sum()

successful_fits = total_fits - failed_location

print("\n==============================")
print("Fitting diagnostics")
print("==============================")

print(
    f"Total GEV fits       : "
    f"{total_fits:,}"
)

print(
    f"Successful fits      : "
    f"{successful_fits:,}"
)

print(
    f"Failed fits          : "
    f"{failed_location:,}"
)

print(
    f"Success rate         : "
    f"{100 * successful_fits / total_fits:.4f}%"
)


# ============================================================
# 8. Create output Dataset
# ============================================================

output_dataset = xr.Dataset(

    data_vars={

        'location': (
            ['sample', 'region_id'],
            output_locations
        ),

        'scale': (
            ['sample', 'region_id'],
            output_scales
        ),

        'shape': (
            ['sample', 'region_id'],
            output_shapes
        ),
    },

    coords={

        'sample': np.arange(num_samples),

        'region_id': regions,
    }
)


# ============================================================
# 9. Variable attributes
# ============================================================

output_dataset['location'].attrs = {

    'long_name':
        'GEV location parameter',

    'description':
        'GEV location parameter fitted to bootstrap '
        'annual hottest-month temperature proxy series'
}


output_dataset['scale'].attrs = {

    'long_name':
        'GEV scale parameter',

    'description':
        'GEV scale parameter fitted to bootstrap '
        'annual hottest-month temperature proxy series'
}


output_dataset['shape'].attrs = {

    'long_name':
        'GEV shape parameter',

    'description':
        'Conventional GEV shape parameter xi. '
        'xi = -c, where c is scipy.stats.genextreme '
        'shape parameter.'
}


# ============================================================
# 10. Global attributes
# ============================================================

output_dataset.attrs = {

    'description':
        'Bootstrap GEV parameters derived from IFS '
        'bias-corrected regional hottest-month temperatures.',

    'period':
        '1981-2024',

    'bootstrap_method':
        'For each proxy realization, one ensemble member '
        'is randomly selected independently for each year. '
        'A GEV distribution is fitted to the resulting '
        '44-year hottest-month temperature series.',

    'number_of_bootstrap_samples':
        num_samples,

    'number_of_ensemble_members':
        n_members,

    'random_seed':
        random_seed,

    'GEV_shape_convention':
        'shape = xi = -scipy.stats.genextreme c'
}


# ============================================================
# 11. Save NetCDF
# ============================================================

print("\nSaving NetCDF...")

encoding = {

    'location': {
        'zlib': True,
        'complevel': 4,
        'dtype': 'float32'
    },

    'scale': {
        'zlib': True,
        'complevel': 4,
        'dtype': 'float32'
    },

    'shape': {
        'zlib': True,
        'complevel': 4,
        'dtype': 'float32'
    }
}


output_dataset.to_netcdf(
    output_file,
    encoding=encoding
)


print("\n======================================")
print("✅ All calculations completed")
print("======================================")

print(f"Output file:\n{output_file}")


# ================================================================================
# Part II: Visualization results
# ================================================================================


import numpy as np
import xarray as xr
import matplotlib.pyplot as plt
import cartopy.crs as ccrs
import cartopy.feature as cfeature
import matplotlib.colors as mcolors

from scipy.stats import genextreme


# ============================================================
# 1. Load data and perform GEV fidelity test
# ============================================================

def load_and_test_gev_parameters(
    era5_file,
    proxy_file,
    region_grid_ds
):

    # --------------------------------------------------------
    # Open datasets
    # --------------------------------------------------------
    era5_dataset = xr.open_dataset(era5_file)
    proxy_dataset = xr.open_dataset(proxy_file)

    regions = era5_dataset.region_id.values
    n_regions = len(regions)

    # --------------------------------------------------------
    # Arrays for observed GEV parameters
    # --------------------------------------------------------
    era5_locations = np.full(n_regions, np.nan)
    era5_scales = np.full(n_regions, np.nan)
    era5_shapes = np.full(n_regions, np.nan)

    # --------------------------------------------------------
    # Proxy GEV parameters
    #
    # Dimensions:
    # sample × region_id
    # --------------------------------------------------------
    proxy_locations = proxy_dataset.location.values
    proxy_scales = proxy_dataset.scale.values
    proxy_shapes = proxy_dataset["shape"].values

    # --------------------------------------------------------
    # Classification:
    #
    # 0 = multiple failures / other
    # 1 = location fail only
    # 2 = scale fail only
    # 3 = shape fail only
    # 4 = all pass
    # --------------------------------------------------------
    category = np.zeros(n_regions)

    # ========================================================
    # Loop over regions
    # ========================================================

    for i, region in enumerate(regions):

        # ----------------------------------------------------
        # Observed hottest-month temperature
        # 1981–2024
        #
        # IMPORTANT:
        # No detrending here because the IFS proxy GEV
        # parameters were fitted to the raw 1981–2024 series.
        # ----------------------------------------------------
        obs_data = (
            era5_dataset
            .sel(
                region_id=region,
                year=slice(1981, 2024)
            )
            .t2m_hottest
            .values
        )

        # Remove NaN / inf
        obs_data = obs_data[np.isfinite(obs_data)]

        # ----------------------------------------------------
        # Fit GEV to observations
        #
        # scipy:
        # c, loc, scale
        #
        # conventional shape xi = -c
        # ----------------------------------------------------
        if len(obs_data) >= 3:

            try:

                c, loc, scale = genextreme.fit(obs_data)

                era5_locations[i] = loc
                era5_scales[i] = scale
                era5_shapes[i] = -c

            except Exception:

                # Leave NaN if fitting fails
                continue

        else:
            continue

        # ----------------------------------------------------
        # Calculate 5th–95th percentile range
        # from 10,000 IFS proxy GEV fits
        # ----------------------------------------------------

        location_5th, location_95th = np.nanpercentile(
            proxy_locations[:, i],
            [5, 95]
        )

        scale_5th, scale_95th = np.nanpercentile(
            proxy_scales[:, i],
            [5, 95]
        )

        shape_5th, shape_95th = np.nanpercentile(
            proxy_shapes[:, i],
            [5, 95]
        )

        # ----------------------------------------------------
        # Fidelity tests
        # ----------------------------------------------------

        location_pass = (
            location_5th
            <= era5_locations[i]
            <= location_95th
        )

        scale_pass = (
            scale_5th
            <= era5_scales[i]
            <= scale_95th
        )

        shape_pass = (
            shape_5th
            <= era5_shapes[i]
            <= shape_95th
        )

        # ----------------------------------------------------
        # Classification
        # ----------------------------------------------------

        if location_pass and scale_pass and shape_pass:

            category[i] = 4

        elif (
            not location_pass
            and scale_pass
            and shape_pass
        ):

            category[i] = 1

        elif (
            location_pass
            and not scale_pass
            and shape_pass
        ):

            category[i] = 2

        elif (
            location_pass
            and scale_pass
            and not shape_pass
        ):

            category[i] = 3

        else:

            # More than one parameter fails
            category[i] = 0


    # ========================================================
    # Print diagnostics
    # ========================================================

    print("\n======================================")
    print("GEV Fidelity Test Summary")
    print("======================================")

    print(
        f"Other / multiple fail : "
        f"{np.sum(category == 0)}"
    )

    print(
        f"Location only fail    : "
        f"{np.sum(category == 1)}"
    )

    print(
        f"Scale only fail       : "
        f"{np.sum(category == 2)}"
    )

    print(
        f"Shape only fail       : "
        f"{np.sum(category == 3)}"
    )

    print(
        f"All pass              : "
        f"{np.sum(category == 4)}"
    )

    print(
        f"All-pass percentage   : "
        f"{100 * np.sum(category == 4) / n_regions:.2f}%"
    )


    # ========================================================
    # Convert region values to spatial grid
    # ========================================================

    region_grid = region_grid_ds.region_id

    category_grid = xr.full_like(
        region_grid,
        np.nan,
        dtype=float
    )

    for i, rid in enumerate(regions):

        category_grid = category_grid.where(
            region_grid != rid,
            category[i]
        )


    # Close datasets
    era5_dataset.close()
    proxy_dataset.close()


    # Return map + values for optional diagnostics
    return (
        category_grid,
        era5_locations,
        era5_scales,
        era5_shapes
    )


# ============================================================
# 2. Read region mask
# ============================================================

region_grid_ds = xr.open_dataset(
    "/home/users/kastanie/"
    "Global_regional_analysis/"
    "atmos-WRAF01-v4-1/"
    "region_mask_1deg.nc"
)


# ============================================================
# 3. Perform GEV fidelity test
# ============================================================

(
    grid_category,
    era5_locations,
    era5_scales,
    era5_shapes
) = load_and_test_gev_parameters(

    "Berkeley_hottest_month_by_region_revised_by_ERA5.nc",

    "IFS_proxy_GEV_parameters_hottest_regional_"
    "1981_2024_land_bias_corrected.nc",

    region_grid_ds
)


# ============================================================
# 4. Colormap
# ============================================================

cmap = mcolors.ListedColormap([

    "#d62728",  # 0: Other / multiple failure

    "#1f77b4",  # 1: Location fail

    "#9467bd",  # 2: Scale fail

    "#ff8c00",  # 3: Shape fail

    "#4cbb17"   # 4: All pass
])


norm = mcolors.BoundaryNorm(

    [-0.5, 0.5, 1.5, 2.5, 3.5, 4.5],

    cmap.N
)


# ============================================================
# 5. Plot
# ============================================================

fig = plt.figure(
    figsize=(10, 5)
)

ax = fig.add_subplot(
    1,
    1,
    1,
    projection=ccrs.PlateCarree()
)


# ------------------------------------------------------------
# Title
# ------------------------------------------------------------

ax.set_title(
    "Model Fidelity (corrected)",
    fontsize=24
)


# ------------------------------------------------------------
# Coastlines / borders
# ------------------------------------------------------------

ax.add_feature(
    cfeature.COASTLINE,
    linewidth=0.5
)

ax.add_feature(
    cfeature.BORDERS,
    linewidth=0.5,
    linestyle=":"
)


# ------------------------------------------------------------
# Map extent
# ------------------------------------------------------------

ax.set_extent(
    [-180, 180, -60, 90],
    crs=ccrs.PlateCarree()
)


# ------------------------------------------------------------
# Panel label
# ------------------------------------------------------------

ax.text(
    0.0,
    1.03,
    "(a)",
    transform=ax.transAxes,
    fontsize=24,
    ha="left",
    fontweight="bold"
)


# ------------------------------------------------------------
# Map
# ------------------------------------------------------------

im = ax.pcolormesh(

    region_grid_ds.longitude,

    region_grid_ds.latitude,

    grid_category,

    shading="auto",

    cmap=cmap,

    norm=norm,

    transform=ccrs.PlateCarree()
)


# ============================================================
# 6. Colorbar
# ============================================================

cbar_ax = fig.add_axes(
    [0.13, 0.095, 0.76, 0.03]
)

cbar = fig.colorbar(

    im,

    cax=cbar_ax,

    orientation="horizontal",

    ticks=[0, 1, 2, 3, 4]
)


cbar.ax.set_xticklabels([

    "Other Fail",

    "Location Fail",

    "Scale Fail",

    "Shape Fail",

    "All Pass"
])


cbar.ax.tick_params(

    which="both",

    length=0,

    labelsize=13
)


cbar.set_label(
    " ",
    fontsize=16
)


# ============================================================
# 7. Save
# ============================================================

plt.savefig(

    "IFS_GEV_Parameters_Fidelity_DetailMap.pdf",

    dpi=300,

    bbox_inches="tight"
)


plt.show()
