    "# ============================================================\n",
    "# Save 2D fidelity map to NetCDF\n",
    "# ============================================================\n",
    "\n",
    "fidelity_ds = xr.Dataset(\n",
    "    {\n",
    "        \"fidelity\": grid_category\n",
    "    }\n",
    ")\n",
    "\n",
    "fidelity_ds[\"fidelity\"].attrs = {\n",
    "    \"long_name\": \"GEV parameter fidelity classification\",\n",
    "    \"description\": (\n",
    "        \"0 = Other/multiple fail; \"\n",
    "        \"1 = Location fail; \"\n",
    "        \"2 = Scale fail; \"\n",
    "        \"3 = Shape fail; \"\n",
    "        \"4 = All pass\"\n",
    "    )\n",
    "}\n",
    "\n",
    "fidelity_ds.attrs = {\n",
    "    \"description\": (\n",
    "        \"Spatial map of IFS model fidelity based on \"\n",
    "        \"GEV location, scale and shape parameters\"\n",
    "    ),\n",
    "    \"period\": \"1981-2024\"\n",
    "}\n",
    "\n",
    "output_nc = \"IFS_GEV_Parameters_Fidelity_DetailMap.nc\"\n",
    "\n",
    "fidelity_ds.to_netcdf(output_nc)\n",
    "\n",
    "print(f\"Saved to: {output_nc}\")"
   ]
