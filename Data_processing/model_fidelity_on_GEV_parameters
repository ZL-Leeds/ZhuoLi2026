    "import numpy as np\n",
    "import xarray as xr\n",
    "import matplotlib.pyplot as plt\n",
    "import cartopy.crs as ccrs\n",
    "import cartopy.feature as cfeature\n",
    "import matplotlib.colors as mcolors\n",
    "\n",
    "from scipy.stats import genextreme\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. Load data and perform GEV fidelity test\n",
    "# ============================================================\n",
    "\n",
    "def load_and_test_gev_parameters(\n",
    "    era5_file,\n",
    "    proxy_file,\n",
    "    region_grid_ds\n",
    "):\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Open datasets\n",
    "    # --------------------------------------------------------\n",
    "    era5_dataset = xr.open_dataset(era5_file)\n",
    "    proxy_dataset = xr.open_dataset(proxy_file)\n",
    "\n",
    "    regions = era5_dataset.region_id.values\n",
    "    n_regions = len(regions)\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Arrays for observed GEV parameters\n",
    "    # --------------------------------------------------------\n",
    "    era5_locations = np.full(n_regions, np.nan)\n",
    "    era5_scales = np.full(n_regions, np.nan)\n",
    "    era5_shapes = np.full(n_regions, np.nan)\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Proxy GEV parameters\n",
    "    #\n",
    "    # Dimensions:\n",
    "    # sample × region_id\n",
    "    # --------------------------------------------------------\n",
    "    proxy_locations = proxy_dataset.location.values\n",
    "    proxy_scales = proxy_dataset.scale.values\n",
    "    proxy_shapes = proxy_dataset[\"shape\"].values\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Classification:\n",
    "    #\n",
    "    # 0 = multiple failures / other\n",
    "    # 1 = location fail only\n",
    "    # 2 = scale fail only\n",
    "    # 3 = shape fail only\n",
    "    # 4 = all pass\n",
    "    # --------------------------------------------------------\n",
    "    category = np.zeros(n_regions)\n",
    "\n",
    "    # ========================================================\n",
    "    # Loop over regions\n",
    "    # ========================================================\n",
    "\n",
    "    for i, region in enumerate(regions):\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Observed hottest-month temperature\n",
    "        # 1981–2024\n",
    "        #\n",
    "        # IMPORTANT:\n",
    "        # No detrending here because the IFS proxy GEV\n",
    "        # parameters were fitted to the raw 1981–2024 series.\n",
    "        # ----------------------------------------------------\n",
    "        obs_data = (\n",
    "            era5_dataset\n",
    "            .sel(\n",
    "                region_id=region,\n",
    "                year=slice(1981, 2024)\n",
    "            )\n",
    "            .t2m_hottest\n",
    "            .values\n",
    "        )\n",
    "\n",
    "        # Remove NaN / inf\n",
    "        obs_data = obs_data[np.isfinite(obs_data)]\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Fit GEV to observations\n",
    "        #\n",
    "        # scipy:\n",
    "        # c, loc, scale\n",
    "        #\n",
    "        # conventional shape xi = -c\n",
    "        # ----------------------------------------------------\n",
    "        if len(obs_data) >= 3:\n",
    "\n",
    "            try:\n",
    "\n",
    "                c, loc, scale = genextreme.fit(obs_data)\n",
    "\n",
    "                era5_locations[i] = loc\n",
    "                era5_scales[i] = scale\n",
    "                era5_shapes[i] = -c\n",
    "\n",
    "            except Exception:\n",
    "\n",
    "                # Leave NaN if fitting fails\n",
    "                continue\n",
    "\n",
    "        else:\n",
    "            continue\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Calculate 5th–95th percentile range\n",
    "        # from 10,000 IFS proxy GEV fits\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        location_5th, location_95th = np.nanpercentile(\n",
    "            proxy_locations[:, i],\n",
    "            [5, 95]\n",
    "        )\n",
    "\n",
    "        scale_5th, scale_95th = np.nanpercentile(\n",
    "            proxy_scales[:, i],\n",
    "            [5, 95]\n",
    "        )\n",
    "\n",
    "        shape_5th, shape_95th = np.nanpercentile(\n",
    "            proxy_shapes[:, i],\n",
    "            [5, 95]\n",
    "        )\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Fidelity tests\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        location_pass = (\n",
    "            location_5th\n",
    "            <= era5_locations[i]\n",
    "            <= location_95th\n",
    "        )\n",
    "\n",
    "        scale_pass = (\n",
    "            scale_5th\n",
    "            <= era5_scales[i]\n",
    "            <= scale_95th\n",
    "        )\n",
    "\n",
    "        shape_pass = (\n",
    "            shape_5th\n",
    "            <= era5_shapes[i]\n",
    "            <= shape_95th\n",
    "        )\n",
    "\n",
    "        # ----------------------------------------------------\n",
    "        # Classification\n",
    "        # ----------------------------------------------------\n",
    "\n",
    "        if location_pass and scale_pass and shape_pass:\n",
    "\n",
    "            category[i] = 4\n",
    "\n",
    "        elif (\n",
    "            not location_pass\n",
    "            and scale_pass\n",
    "            and shape_pass\n",
    "        ):\n",
    "\n",
    "            category[i] = 1\n",
    "\n",
    "        elif (\n",
    "            location_pass\n",
    "            and not scale_pass\n",
    "            and shape_pass\n",
    "        ):\n",
    "\n",
    "            category[i] = 2\n",
    "\n",
    "        elif (\n",
    "            location_pass\n",
    "            and scale_pass\n",
    "            and not shape_pass\n",
    "        ):\n",
    "\n",
    "            category[i] = 3\n",
    "\n",
    "        else:\n",
    "\n",
    "            # More than one parameter fails\n",
    "            category[i] = 0\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Print diagnostics\n",
    "    # ========================================================\n",
    "\n",
    "    print(\"\\n======================================\")\n",
    "    print(\"GEV Fidelity Test Summary\")\n",
    "    print(\"======================================\")\n",
    "\n",
    "    print(\n",
    "        f\"Other / multiple fail : \"\n",
    "        f\"{np.sum(category == 0)}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Location only fail    : \"\n",
    "        f\"{np.sum(category == 1)}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Scale only fail       : \"\n",
    "        f\"{np.sum(category == 2)}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"Shape only fail       : \"\n",
    "        f\"{np.sum(category == 3)}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"All pass              : \"\n",
    "        f\"{np.sum(category == 4)}\"\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        f\"All-pass percentage   : \"\n",
    "        f\"{100 * np.sum(category == 4) / n_regions:.2f}%\"\n",
    "    )\n",
    "\n",
    "\n",
    "    # ========================================================\n",
    "    # Convert region values to spatial grid\n",
    "    # ========================================================\n",
    "\n",
    "    region_grid = region_grid_ds.region_id\n",
    "\n",
    "    category_grid = xr.full_like(\n",
    "        region_grid,\n",
    "        np.nan,\n",
    "        dtype=float\n",
    "    )\n",
    "\n",
    "    for i, rid in enumerate(regions):\n",
    "\n",
    "        category_grid = category_grid.where(\n",
    "            region_grid != rid,\n",
    "            category[i]\n",
    "        )\n",
    "\n",
    "\n",
    "    # Close datasets\n",
    "    era5_dataset.close()\n",
    "    proxy_dataset.close()\n",
    "\n",
    "\n",
    "    # Return map + values for optional diagnostics\n",
    "    return (\n",
    "        category_grid,\n",
    "        era5_locations,\n",
    "        era5_scales,\n",
    "        era5_shapes\n",
    "    )\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. Read region mask\n",
    "# ============================================================\n",
    "\n",
    "region_grid_ds = xr.open_dataset(\n",
    "    \"/home/users/kastanie/\"\n",
    "    \"Global_regional_analysis/\"\n",
    "    \"atmos-WRAF01-v4-1/\"\n",
    "    \"region_mask_1deg.nc\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. Perform GEV fidelity test\n",
    "# ============================================================\n",
    "\n",
    "(\n",
    "    grid_category,\n",
    "    era5_locations,\n",
    "    era5_scales,\n",
    "    era5_shapes\n",
    ") = load_and_test_gev_parameters(\n",
    "\n",
    "    \"Berkeley_hottest_month_by_region_revised_by_ERA5.nc\",\n",
    "\n",
    "    \"IFS_proxy_GEV_parameters_hottest_regional_\"\n",
    "    \"1981_2024_land_bias_corrected.nc\",\n",
    "\n",
    "    region_grid_ds\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. Colormap\n",
    "# ============================================================\n",
    "\n",
    "cmap = mcolors.ListedColormap([\n",
    "\n",
    "    \"#d62728\",  # 0: Other / multiple failure\n",
    "\n",
    "    \"#1f77b4\",  # 1: Location fail\n",
    "\n",
    "    \"#9467bd\",  # 2: Scale fail\n",
    "\n",
    "    \"#ff8c00\",  # 3: Shape fail\n",
    "\n",
    "    \"#4cbb17\"   # 4: All pass\n",
    "])\n",
    "\n",
    "\n",
    "norm = mcolors.BoundaryNorm(\n",
    "\n",
    "    [-0.5, 0.5, 1.5, 2.5, 3.5, 4.5],\n",
    "\n",
    "    cmap.N\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. Plot\n",
    "# ============================================================\n",
    "\n",
    "fig = plt.figure(\n",
    "    figsize=(10, 5)\n",
    ")\n",
    "\n",
    "ax = fig.add_subplot(\n",
    "    1,\n",
    "    1,\n",
    "    1,\n",
    "    projection=ccrs.PlateCarree()\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Title\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ax.set_title(\n",
    "    \"Model Fidelity (corrected)\",\n",
    "    fontsize=24\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Coastlines / borders\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ax.add_feature(\n",
    "    cfeature.COASTLINE,\n",
    "    linewidth=0.5\n",
    ")\n",
    "\n",
    "ax.add_feature(\n",
    "    cfeature.BORDERS,\n",
    "    linewidth=0.5,\n",
    "    linestyle=\":\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Map extent\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ax.set_extent(\n",
    "    [-180, 180, -60, 90],\n",
    "    crs=ccrs.PlateCarree()\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Panel label\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "ax.text(\n",
    "    0.0,\n",
    "    1.03,\n",
    "    \"(a)\",\n",
    "    transform=ax.transAxes,\n",
    "    fontsize=24,\n",
    "    ha=\"left\",\n",
    "    fontweight=\"bold\"\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Map\n",
    "# ------------------------------------------------------------\n",
    "\n",
    "im = ax.pcolormesh(\n",
    "\n",
    "    region_grid_ds.longitude,\n",
    "\n",
    "    region_grid_ds.latitude,\n",
    "\n",
    "    grid_category,\n",
    "\n",
    "    shading=\"auto\",\n",
    "\n",
    "    cmap=cmap,\n",
    "\n",
    "    norm=norm,\n",
    "\n",
    "    transform=ccrs.PlateCarree()\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. Colorbar\n",
    "# ============================================================\n",
    "\n",
    "cbar_ax = fig.add_axes(\n",
    "    [0.13, 0.095, 0.76, 0.03]\n",
    ")\n",
    "\n",
    "cbar = fig.colorbar(\n",
    "\n",
    "    im,\n",
    "\n",
    "    cax=cbar_ax,\n",
    "\n",
    "    orientation=\"horizontal\",\n",
    "\n",
    "    ticks=[0, 1, 2, 3, 4]\n",
    ")\n",
    "\n",
    "\n",
    "cbar.ax.set_xticklabels([\n",
    "\n",
    "    \"Other Fail\",\n",
    "\n",
    "    \"Location Fail\",\n",
    "\n",
    "    \"Scale Fail\",\n",
    "\n",
    "    \"Shape Fail\",\n",
    "\n",
    "    \"All Pass\"\n",
    "])\n",
    "\n",
    "\n",
    "cbar.ax.tick_params(\n",
    "\n",
    "    which=\"both\",\n",
    "\n",
    "    length=0,\n",
    "\n",
    "    labelsize=13\n",
    ")\n",
    "\n",
    "\n",
    "cbar.set_label(\n",
    "    \" \",\n",
    "    fontsize=16\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. Save\n",
    "# ============================================================\n",
    "\n",
    "plt.savefig(\n",
    "\n",
    "    \"IFS_GEV_Parameters_Fidelity_DetailMap.pdf\",\n",
    "\n",
    "    dpi=300,\n",
    "\n",
    "    bbox_inches=\"tight\"\n",
    ")\n",
    "\n",
    "\n",
    "plt.show()"
   ]
