    "import os\n",
    "import time\n",
    "import numpy as np\n",
    "import xarray as xr\n",
    "\n",
    "from scipy.stats import genextreme\n",
    "from joblib import Parallel, delayed\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 0. Settings\n",
    "# ============================================================\n",
    "\n",
    "data_file = 'IFS_t2m_hottest_month_bias_corrected.nc'\n",
    "\n",
    "output_file = (\n",
    "    'IFS_proxy_GEV_parameters_hottest_regional_'\n",
    "    '1981_2024_land_bias_corrected.nc'\n",
    ")\n",
    "\n",
    "# Number of bootstrap/proxy samples\n",
    "num_samples = 10000\n",
    "\n",
    "# Number of parallel workers\n",
    "n_jobs = 16\n",
    "\n",
    "# Random seed for reproducibility\n",
    "random_seed = 42\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 1. Read data\n",
    "# ============================================================\n",
    "\n",
    "print(\"Reading data...\")\n",
    "\n",
    "ds = xr.open_dataset(data_file)\n",
    "\n",
    "# Select period and enforce dimension order:\n",
    "# region_id × number × year\n",
    "da = (\n",
    "    ds['t2m_hottest_month']\n",
    "    .sel(year=slice('1981', '2024'))\n",
    "    .transpose('region_id', 'number', 'year')\n",
    ")\n",
    "\n",
    "regions = da.region_id.values\n",
    "\n",
    "# Load into memory\n",
    "data = da.values\n",
    "\n",
    "n_regions, n_members, n_years = data.shape\n",
    "\n",
    "ds.close()\n",
    "\n",
    "print(\"\\n==============================\")\n",
    "print(\"Input information\")\n",
    "print(\"==============================\")\n",
    "print(f\"Data shape        : {data.shape}\")\n",
    "print(f\"Regions           : {n_regions}\")\n",
    "print(f\"Ensemble members  : {n_members}\")\n",
    "print(f\"Years             : {n_years}\")\n",
    "print(f\"Bootstrap samples : {num_samples}\")\n",
    "print(f\"Parallel workers  : {n_jobs}\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 2. Function for one region\n",
    "# ============================================================\n",
    "\n",
    "def fit_region_gev(region_index, region_data, num_samples, seed):\n",
    "    \"\"\"\n",
    "    For one region:\n",
    "\n",
    "    1. For each year, randomly select one ensemble member.\n",
    "    2. Construct num_samples proxy time series.\n",
    "    3. Fit a GEV distribution to each proxy series.\n",
    "    4. Return location, scale, and conventional shape xi.\n",
    "\n",
    "    scipy.stats.genextreme:\n",
    "        c, loc, scale\n",
    "\n",
    "    Conventional GEV shape:\n",
    "        xi = -c\n",
    "    \"\"\"\n",
    "\n",
    "    rng = np.random.default_rng(seed)\n",
    "\n",
    "    n_members, n_years = region_data.shape\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Generate all bootstrap member indices at once\n",
    "    # shape = (num_samples, n_years)\n",
    "    # --------------------------------------------------------\n",
    "    member_indices = rng.integers(\n",
    "        low=0,\n",
    "        high=n_members,\n",
    "        size=(num_samples, n_years)\n",
    "    )\n",
    "\n",
    "    year_indices = np.arange(n_years)\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Construct proxy time series\n",
    "    # sampled_data shape = (num_samples, n_years)\n",
    "    # --------------------------------------------------------\n",
    "    sampled_data = region_data[\n",
    "        member_indices,\n",
    "        year_indices[None, :]\n",
    "    ]\n",
    "\n",
    "    # Output arrays\n",
    "    locations = np.full(\n",
    "        num_samples,\n",
    "        np.nan,\n",
    "        dtype=np.float64\n",
    "    )\n",
    "\n",
    "    scales = np.full(\n",
    "        num_samples,\n",
    "        np.nan,\n",
    "        dtype=np.float64\n",
    "    )\n",
    "\n",
    "    shapes = np.full(\n",
    "        num_samples,\n",
    "        np.nan,\n",
    "        dtype=np.float64\n",
    "    )\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # GEV fitting\n",
    "    # --------------------------------------------------------\n",
    "    for j in range(num_samples):\n",
    "\n",
    "        x = sampled_data[j]\n",
    "\n",
    "        # Remove NaN/inf if present\n",
    "        if not np.all(np.isfinite(x)):\n",
    "            x = x[np.isfinite(x)]\n",
    "\n",
    "        if x.size < 3:\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "\n",
    "            c, loc, scale = genextreme.fit(x)\n",
    "\n",
    "            locations[j] = loc\n",
    "            scales[j] = scale\n",
    "\n",
    "            # Conventional GEV shape parameter xi\n",
    "            shapes[j] = -c\n",
    "\n",
    "        except Exception:\n",
    "\n",
    "            # Keep NaN if fit fails\n",
    "            continue\n",
    "\n",
    "    return region_index, locations, scales, shapes\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. Generate independent random seeds\n",
    "# ============================================================\n",
    "\n",
    "seed_sequence = np.random.SeedSequence(random_seed)\n",
    "\n",
    "region_seed_sequences = seed_sequence.spawn(n_regions)\n",
    "\n",
    "region_seeds = [\n",
    "    int(s.generate_state(1)[0])\n",
    "    for s in region_seed_sequences\n",
    "]\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. Initialize output arrays\n",
    "# ============================================================\n",
    "\n",
    "output_locations = np.full(\n",
    "    (num_samples, n_regions),\n",
    "    np.nan,\n",
    "    dtype=np.float64\n",
    ")\n",
    "\n",
    "output_scales = np.full(\n",
    "    (num_samples, n_regions),\n",
    "    np.nan,\n",
    "    dtype=np.float64\n",
    ")\n",
    "\n",
    "output_shapes = np.full(\n",
    "    (num_samples, n_regions),\n",
    "    np.nan,\n",
    "    dtype=np.float64\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 5. Parallel GEV fitting with real-time tqdm progress\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\nStarting parallel GEV fitting...\\n\")\n",
    "\n",
    "start_time = time.time()\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# return_as=\"generator_unordered\"\n",
    "#\n",
    "# Results are returned immediately whenever any worker\n",
    "# finishes a region.\n",
    "#\n",
    "# Therefore tqdm updates continuously as regions finish.\n",
    "# ------------------------------------------------------------\n",
    "parallel_results = Parallel(\n",
    "    n_jobs=n_jobs,\n",
    "    backend='loky',\n",
    "    return_as='generator_unordered'\n",
    ")(\n",
    "    delayed(fit_region_gev)(\n",
    "        i,\n",
    "        data[i],\n",
    "        num_samples,\n",
    "        region_seeds[i]\n",
    "    )\n",
    "    for i in range(n_regions)\n",
    ")\n",
    "\n",
    "\n",
    "# ------------------------------------------------------------\n",
    "# Real-time progress bar\n",
    "# ------------------------------------------------------------\n",
    "for result in tqdm(\n",
    "    parallel_results,\n",
    "    total=n_regions,\n",
    "    desc=\"Regions\",\n",
    "    unit=\"region\"\n",
    "):\n",
    "\n",
    "    region_index, loc, scale, shape = result\n",
    "\n",
    "    output_locations[:, region_index] = loc\n",
    "    output_scales[:, region_index] = scale\n",
    "    output_shapes[:, region_index] = shape\n",
    "\n",
    "\n",
    "elapsed = time.time() - start_time\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 6. Timing information\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\n==============================\")\n",
    "print(\"GEV fitting completed\")\n",
    "print(\"==============================\")\n",
    "\n",
    "print(\n",
    "    f\"Elapsed time: \"\n",
    "    f\"{elapsed / 60:.2f} minutes\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Elapsed time: \"\n",
    "    f\"{elapsed / 3600:.2f} hours\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 7. Fitting diagnostics\n",
    "# ============================================================\n",
    "\n",
    "total_fits = num_samples * n_regions\n",
    "\n",
    "failed_location = np.isnan(output_locations).sum()\n",
    "failed_scale = np.isnan(output_scales).sum()\n",
    "failed_shape = np.isnan(output_shapes).sum()\n",
    "\n",
    "successful_fits = total_fits - failed_location\n",
    "\n",
    "print(\"\\n==============================\")\n",
    "print(\"Fitting diagnostics\")\n",
    "print(\"==============================\")\n",
    "\n",
    "print(\n",
    "    f\"Total GEV fits       : \"\n",
    "    f\"{total_fits:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Successful fits      : \"\n",
    "    f\"{successful_fits:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Failed fits          : \"\n",
    "    f\"{failed_location:,}\"\n",
    ")\n",
    "\n",
    "print(\n",
    "    f\"Success rate         : \"\n",
    "    f\"{100 * successful_fits / total_fits:.4f}%\"\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 8. Create output Dataset\n",
    "# ============================================================\n",
    "\n",
    "output_dataset = xr.Dataset(\n",
    "\n",
    "    data_vars={\n",
    "\n",
    "        'location': (\n",
    "            ['sample', 'region_id'],\n",
    "            output_locations\n",
    "        ),\n",
    "\n",
    "        'scale': (\n",
    "            ['sample', 'region_id'],\n",
    "            output_scales\n",
    "        ),\n",
    "\n",
    "        'shape': (\n",
    "            ['sample', 'region_id'],\n",
    "            output_shapes\n",
    "        ),\n",
    "    },\n",
    "\n",
    "    coords={\n",
    "\n",
    "        'sample': np.arange(num_samples),\n",
    "\n",
    "        'region_id': regions,\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 9. Variable attributes\n",
    "# ============================================================\n",
    "\n",
    "output_dataset['location'].attrs = {\n",
    "\n",
    "    'long_name':\n",
    "        'GEV location parameter',\n",
    "\n",
    "    'description':\n",
    "        'GEV location parameter fitted to bootstrap '\n",
    "        'annual hottest-month temperature proxy series'\n",
    "}\n",
    "\n",
    "\n",
    "output_dataset['scale'].attrs = {\n",
    "\n",
    "    'long_name':\n",
    "        'GEV scale parameter',\n",
    "\n",
    "    'description':\n",
    "        'GEV scale parameter fitted to bootstrap '\n",
    "        'annual hottest-month temperature proxy series'\n",
    "}\n",
    "\n",
    "\n",
    "output_dataset['shape'].attrs = {\n",
    "\n",
    "    'long_name':\n",
    "        'GEV shape parameter',\n",
    "\n",
    "    'description':\n",
    "        'Conventional GEV shape parameter xi. '\n",
    "        'xi = -c, where c is scipy.stats.genextreme '\n",
    "        'shape parameter.'\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 10. Global attributes\n",
    "# ============================================================\n",
    "\n",
    "output_dataset.attrs = {\n",
    "\n",
    "    'description':\n",
    "        'Bootstrap GEV parameters derived from IFS '\n",
    "        'bias-corrected regional hottest-month temperatures.',\n",
    "\n",
    "    'period':\n",
    "        '1981-2024',\n",
    "\n",
    "    'bootstrap_method':\n",
    "        'For each proxy realization, one ensemble member '\n",
    "        'is randomly selected independently for each year. '\n",
    "        'A GEV distribution is fitted to the resulting '\n",
    "        '44-year hottest-month temperature series.',\n",
    "\n",
    "    'number_of_bootstrap_samples':\n",
    "        num_samples,\n",
    "\n",
    "    'number_of_ensemble_members':\n",
    "        n_members,\n",
    "\n",
    "    'random_seed':\n",
    "        random_seed,\n",
    "\n",
    "    'GEV_shape_convention':\n",
    "        'shape = xi = -scipy.stats.genextreme c'\n",
    "}\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 11. Save NetCDF\n",
    "# ============================================================\n",
    "\n",
    "print(\"\\nSaving NetCDF...\")\n",
    "\n",
    "encoding = {\n",
    "\n",
    "    'location': {\n",
    "        'zlib': True,\n",
    "        'complevel': 4,\n",
    "        'dtype': 'float32'\n",
    "    },\n",
    "\n",
    "    'scale': {\n",
    "        'zlib': True,\n",
    "        'complevel': 4,\n",
    "        'dtype': 'float32'\n",
    "    },\n",
    "\n",
    "    'shape': {\n",
    "        'zlib': True,\n",
    "        'complevel': 4,\n",
    "        'dtype': 'float32'\n",
    "    }\n",
    "}\n",
    "\n",
    "\n",
    "output_dataset.to_netcdf(\n",
    "    output_file,\n",
    "    encoding=encoding\n",
    ")\n",
    "\n",
    "\n",
    "print(\"\\n======================================\")\n",
    "print(\"✅ All calculations completed\")\n",
    "print(\"======================================\")\n",
    "\n",
    "print(f\"Output file:\\n{output_file}\")"
   ]
